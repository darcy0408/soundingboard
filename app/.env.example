# Copy to .env and adjust for your environment. Defaults to http://localhost:8787 if unset
# (see src/lib/api.ts).
EXPO_PUBLIC_WORKER_URL=http://localhost:8787

# RevenueCat iOS public SDK key (Project Settings > API Keys in the RevenueCat dashboard — the
# "Apple App Store" key, not a secret key). Safe to ship in the app bundle, same as Stripe's
# publishable key — it authenticates the app to RevenueCat, not a privileged credential. Leave
# unset to run with purchases disabled (src/lib/purchases.ts no-ops without it). See
# app/README.md's Monetization setup section.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
